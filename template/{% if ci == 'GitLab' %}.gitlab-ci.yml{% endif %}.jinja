---
variables:
  MISE_DATA_DIR: "$CI_PROJECT_DIR/.mise"
  MISE_CACHE_DIR: "$CI_PROJECT_DIR/.mise/cache"
  # GitLab CI creates a separate mountpoint for the build directory,
  # so we need to copy instead of using hard links.
  UV_LINK_MODE: copy

pages:
  stage: deploy
  image: ghcr.io/jdx/mise:2026.10.4-debian
  variables:
    UV_CACHE_DIR: "$CI_PROJECT_DIR/.uv-cache"
  cache:
    - key:
        files:
          - docs/mise.toml
          - docs/uv.lock
      paths:
        - .mise/installs/
        - .mise/cache/
        - .uv-cache/
  script:
    - cd docs/
    - mise install
    - mise run build
    - mise exec -- uv cache prune --ci
    # GitLab expects the documentation in the public/ folder in the root
    - mkdir -p ../public
    - cp -rv public/* ../public
  artifacts:
    paths:
      - public
  rules:
    - if: '$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
