{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>virtlink/renovate-config"],
  "enabledManagers": ["github-actions", "gitlabci", "mise"],
  "github-actions": {
    "managerFilePatterns": [
      "/^\\.github/workflows/[^/]+\\.ya?ml$/",
      "/^template/.*workflows/[^/]+\\.ya?ml$/"
    ]
  },
  "gitlabci": {
    "managerFilePatterns": [
      "/^\\.gitlab-ci\\.ya?ml$/",
      "/^template/.*\\.gitlab-ci\\.ya?ml.*\\.jinja$/"
    ]
  },
  "mise": {
    "managerFilePatterns": [
      "/^docs/mise\\.toml$/",
      "/^template/docs/mise\\.toml$/"
    ]
  }
}
